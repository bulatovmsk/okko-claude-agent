{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okko.design/schemas/gaps.schema.json",
  "type": "object",
  "required": ["schemaVersion", "gaps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "title", "question", "platforms", "componentIds", "sourceLinks"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "status": {"enum": ["open", "resolved"]},
          "title": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "platforms": {"type": "array", "uniqueItems": true, "items": {"enum": ["android", "ios", "tv", "web"]}},
          "componentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "sourceLinks": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
          "resolution": {"type": "string"}
        }
      }
    }
  }
}
