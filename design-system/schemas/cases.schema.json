{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okko.design/schemas/cases.schema.json",
  "type": "object",
  "required": ["schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "title", "platforms", "deviceClasses", "componentIds", "situation", "decision", "constraints", "sourceLinks"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "status": {"enum": ["draft", "confirmed"]},
          "title": {"type": "string", "minLength": 1},
          "platforms": {"type": "array", "uniqueItems": true, "items": {"enum": ["android", "ios", "tv", "web"]}},
          "deviceClasses": {"type": "array", "uniqueItems": true, "items": {"enum": ["phone", "tablet", "tv", "web-desktop"]}},
          "componentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "situation": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "constraints": {"type": "array", "items": {"type": "string"}},
          "sourceLinks": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
        }
      }
    }
  }
}
