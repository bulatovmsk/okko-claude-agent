# Пример конфига. Скопируй в .env и заполни. .env не уходит в git.

# Personal Access Token из Figma
# https://www.figma.com/settings → Personal access tokens
# Scopes: File content: Read, Variables: Read
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxx

# Ключ файла Figma-библиотеки Окко (из URL: figma.com/design/<FILE_KEY>/...)
FIGMA_LIB_IOS_KEY=rMcDm5qGp4CXkXXddEbcMh

# Дополнительно: ключи библиотек для других платформ, когда добавим
# FIGMA_LIB_ANDROID_KEY=
# FIGMA_LIB_WEB_KEY=
# FIGMA_LIB_TV_KEY=
